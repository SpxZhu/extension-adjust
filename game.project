[project]
title = AdjustExample
version = 0.1.0

[bootstrap]
main_collection = /example/main.collectionc

[script]
shared_state = 1

[display]
width = 720
height = 1280

[input]
game_binding = /input/game.input_bindingc

[library]
include_dirs = extension-adjust
defold_min_version = 1.13.0

[android]
package = com.defold.adjust.example
minimum_sdk_version = 24

[ios]
bundle_identifier = com.defold.adjust.example

[adjust]
ios_user_tracking_usage_description = Allow tracking to help measure advertising effectiveness.
